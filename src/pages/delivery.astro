    <div class="store-card" onclick="openStore('بيتزا هت')">
      <div class="store-image" style="background: linear-gradient(135deg, #DC2626, #F87171);">
        🍕
        <div class="store-badge">مفتوح ✅</div>
      </div>
      <div class="store-info">
        <div class="store-name">بيتزا هت</div>
        <div class="store-meta">
          <span class="store-meta-item">⭐ 4.6</span>
          <span class="store-meta-item">⏱️ 30-45 دقيقة</span>
          <span class="store-meta-item">🚚 10 جنيه</span>
        </div>
        <div class="store-tags">
          <span class="store-tag">بيتزا</span>
          <span class="store-tag">وجبات سريعة</span>
        </div>
      </div>
    </div>

    <div class="store-card" onclick="openStore('متجر الإلكترونيات')">
      <div class="store-image" style="background: linear-gradient(135deg, #7C3AED, #A855F7);">
        📱
        <div class="store-badge closed">مغلق حالياً</div>
      </div>
      <div class="store-info">
        <div class="store-name">متجر الإلكترونيات</div>
        <div class="store-meta">
          <span class="store-meta-item">⭐ 4.7</span>
          <span class="store-meta-item">⏱️ 45-60 دقيقة</span>
          <span class="store-meta-item">🚚 15 جنيه</span>
        </div>
        <div class="store-tags">
          <span class="store-tag">موبايلات</span>
          <span class="store-tag">إكسسوارات</span>
        </div>
      </div>
    </div>

    <div class="store-card" onclick="openStore('مخبز الأمل')">
      <div class="store-image" style="background: linear-gradient(135deg, #D97706, #FCD34D);">
        🥖
        <div class="store-badge">مفتوح ✅</div>
      </div>
      <div class="store-info">
        <div class="store-name">مخبز الأمل</div>
        <div class="store-meta">
          <span class="store-meta-item">⭐ 4.9</span>
          <span class="store-meta-item">⏱️ 15-20 دقيقة</span>
          <span class="store-meta-item">🚚 مجاني</span>
        </div>
        <div class="store-tags">
          <span class="store-tag">عيش</span>
          <span class="store-tag">كيك</span>
          <span class="store-tag">حلويات</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Order Panel -->
  <div class="delivery-order-panel">
    <div class="panel-handle"></div>

    <div class="address-input" onclick="setAddress()">
      <span class="address-icon">📍</span>
      <span class="address-text" id="addressText">حدّد موقع التوصيل</span>
      <span style="font-size:18px;color:#94A3B8">→</span>
    </div>

    <div class="price-est">
      <span class="price-est-label">⏱️ التوصيل في ~30 دقيقة</span>
      <span class="price-est-value">من 0 جنيه</span>
    </div>

    <button class="order-btn" onclick="confirmOrder()">
      🛒 اطلب الآن
    </button>
  </div>

  <!-- Store Modal -->
  <div class="modal-overlay" id="storeModal" onclick="closeStore()">
    <div class="modal-sheet" onclick="event.stopPropagation()">
      <div class="modal-handle"></div>
      <div class="modal-title" id="storeName">اسم المتجر</div>

      <div style="display:flex;gap:12px;margin-bottom:20px">
        <div style="background:#F8FAFC;border-radius:12px;padding:10px 16px;font-size:13px;font-weight:700;color:#475569">⭐ 4.8</div>
        <div style="background:#F8FAFC;border-radius:12px;padding:10px 16px;font-size:13px;font-weight:700;color:#475569">⏱️ 30 دقيقة</div>
        <div style="background:#F8FAFC;border-radius:12px;padding:10px 16px;font-size:13px;font-weight:700;color:#475569">🚚 مجاني</div>
      </div>

      <div style="font-size:16px;font-weight:800;color:#1E293B;margin-bottom:12px">🛍️ الأصناف المتاحة</div>

      <div class="item-card">
        <div class="item-icon">🥛</div>
        <div><div class="item-name">لبن بلدي 1 لتر</div><div class="item-price">25 جنيه</div></div>
        <div class="item-counter">
          <button class="counter-btn" onclick="changeQty(this, -1)">-</button>
          <span class="counter-num">0</span>
          <button class="counter-btn" onclick="changeQty(this, 1)">+</button>
        </div>
      </div>

      <div class="item-card">
        <div class="item-icon">🍞</div>
        <div><div class="item-name">عيش توست كامل</div><div class="item-price">15 جنيه</div></div>
        <div class="item-counter">
          <button class="counter-btn" onclick="changeQty(this, -1)">-</button>
          <span class="counter-num">0</span>
          <button class="counter-btn" onclick="changeQty(this, 1)">+</button>
        </div>
      </div>

      <div class="item-card">
        <div class="item-icon">🧃</div>
        <div><div class="item-name">عصير برتقال طبيعي</div><div class="item-price">20 جنيه</div></div>
        <div class="item-counter">
          <button class="counter-btn" onclick="changeQty(this, -1)">-</button>
          <span class="counter-num">0</span>
          <button class="counter-btn" onclick="changeQty(this, 1)">+</button>
        </div>
      </div>

      <div class="item-card">
        <div class="item-icon">🧀</div>
        <div><div class="item-name">جبنة رومي 250 جم</div><div class="item-price">45 جنيه</div></div>
        <div class="item-counter">
          <button class="counter-btn" onclick="changeQty(this, -1)">-</button>
          <span class="counter-num">0</span>
          <button class="counter-btn" onclick="changeQty(this, 1)">+</button>
        </div>
      </div>

      <button onclick="addToCart(); closeStore();" style="width:100%;padding:16px;background:linear-gradient(135deg,#1E3A8A,#1D4ED8);color:white;border:none;border-radius:14px;font-family:'Cairo',sans-serif;font-size:17px;font-weight:800;cursor:pointer;margin-top:8px">
        🛒 أضف للسلة
      </button>
    </div>
  </div>

  <!-- Bottom Nav -->
  <nav class="bottom-nav">
    <a href="/home" class="nav-item">
      <span class="nav-icon">🏠</span>
      <span>الرئيسية</span>
    </a>
    <a href="/orders" class="nav-item">
      <span class="nav-icon">📋</span>
      <span>طلباتي</span>
    </a>
    <a href="/delivery" class="nav-center-btn">+</a>
    <a href="/wallet" class="nav-item">
      <span class="nav-icon">👛</span>
      <span>المحفظة</span>
    </a>
    <a href="/settings" class="nav-item">
      <span class="nav-icon">⚙️</span>
      <span>الإعدادات</span>
    </a>
  </nav>

  <script>
    import { createClient } from '@supabase/supabase-js';
    const supabase = createClient(
      'https://ifpopyplwpmrapaofimi.supabase.co',
      'sb_publishable_kazC7uOBFXz8-AuIfXD7mA_cBb4_EtH'
    );

    let cart = {};
    let currentStore = null;
    let currentProducts = [];
    let session = null;

    // Auth check + load stores on boot
    (async () => {
      const { data: { session: s } } = await supabase.auth.getSession();
      session = s;
      await loadStores();
    })();

    async function loadStores(category = null) {
      const grid = document.getElementById('storesGrid');
      if (!grid) return;
      grid.innerHTML = '<p style="text-align:center;color:#888;padding:40px">⏳ جاري التحميل...</p>';

      let query = supabase.from('stores').select('*').eq('is_active', true).order('rating', { ascending: false });
      if (category) query = query.eq('category', category);

      const { data: stores, error } = await query;
      if (error || !stores?.length) {
        grid.innerHTML = '<p style="text-align:center;color:#888;padding:40px">لا توجد متاجر متاحة</p>';
        return;
      }

      grid.innerHTML = stores.map(s => `
        <div class="store-card" onclick="openStore('${s.id}','${s.name_ar}')">
          <div class="store-image">${s.image_emoji}</div>
          <div class="store-info">
            <h3 class="store-name">${s.name_ar}</h3>
            <div class="store-meta">
              <span>⭐ ${s.rating}</span>
              <span>⏱ ${s.delivery_time} دقيقة</span>
              <span>${s.delivery_fee == 0 ? '🚚 مجاني' : '🚚 ' + s.delivery_fee + ' ر.س'}</span>
            </div>
          </div>
        </div>
      `).join('');
    }

    async function openStore(storeId, storeName) {
      currentStore = { id: storeId, name: storeName };
      document.getElementById('storeName').textContent = storeName;
      document.getElementById('storeModal').classList.add('show');

      const productsList = document.getElementById('productsList');
      productsList.innerHTML = '<p style="text-align:center;padding:20px">⏳ جاري التحميل...</p>';

      const { data: products } = await supabase
        .from('products').select('*').eq('store_id', storeId).eq('is_available', true);

      currentProducts = products || [];
      productsList.innerHTML = currentProducts.map(p => `
        <div class="product-item" style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #f0f0f0">
          <div>
            <div style="font-weight:700;font-size:14px">${p.image_emoji} ${p.name_ar}</div>
            <div style="color:#1D4ED8;font-weight:700;margin-top:4px">${p.price} ر.س</div>
          </div>
          <div style="display:flex;align-items:center;gap:8px">
            <button onclick="changeQty(this,-1)" style="width:28px;height:28px;border-radius:50%;border:1px solid #ddd;background:#fff;font-size:16px;cursor:pointer">−</button>
            <span class="counter-num" data-id="${p.id}" data-name="${p.name_ar}" data-price="${p.price}">0</span>
            <button onclick="changeQty(this,1)"  style="width:28px;height:28px;border-radius:50%;border:none;background:#1D4ED8;color:white;font-size:16px;cursor:pointer">+</button>
          </div>
        </div>
      `).join('');
    }

    function closeStore() {
      document.getElementById('storeModal').classList.remove('show');
    }

    function changeQty(btn, delta) {
      const numEl = btn.parentElement.querySelector('.counter-num');
      let num = Math.max(0, parseInt(numEl.textContent) + delta);
      numEl.textContent = num;
      const id = numEl.dataset.id;
      if (num === 0) delete cart[id];
      else cart[id] = { name: numEl.dataset.name, price: parseFloat(numEl.dataset.price), qty: num };
      updateCartBadge();
    }

    function updateCartBadge() {
      const total = Object.values(cart).reduce((s, i) => s + i.qty, 0);
      const badge = document.getElementById('cartBadge');
      if (badge) badge.textContent = total > 0 ? total : '';
    }

    function setAddress() {
      const addresses = ['الرياض، حي النزهة', 'جدة، حي الروضة', 'الدمام، حي الشاطئ', 'مكة، العزيزية'];
      const addr = addresses[Math.floor(Math.random() * addresses.length)];
      document.getElementById('addressText').textContent = '📍 ' + addr;
      document.getElementById('addressText').classList.add('filled');
    }

    async function confirmOrder() {
      if (!session) {
        showToast('⚠️ سجّل دخولك أولاً', true);
        setTimeout(() => window.location.href = '/login', 1500);
        return;
      }
      const cartItems = Object.values(cart);
      if (!cartItems.length) { showToast('🛒 السلة فارغة!', true); return; }
      const addr = document.getElementById('addressText').textContent;
      if (addr === 'حدّد موقع التوصيل') { showToast('⚠️ يرجى تحديد موقع التوصيل', true); return; }

      const subtotal = cartItems.reduce((s, i) => s + i.price * i.qty, 0);
      const deliveryFee = 5;

      const { data: order, error: orderErr } = await supabase.from('orders').insert({
        user_id: session.user.id,
        store_id: currentStore.id,
        total_amount: subtotal + deliveryFee,
        delivery_fee: deliveryFee,
        delivery_address: addr,
        status: 'pending'
      }).select().single();

      if (orderErr) { showToast('❌ حدث خطأ، حاول مرة أخرى', true); return; }

      await supabase.from('order_items').insert(
        cartItems.map(i => ({
          order_id: order.id,
          product_id: Object.keys(cart).find(k => cart[k].name === i.name),
          name_ar: i.name,
          quantity: i.qty,
          unit_price: i.price
        }))
      );

      cart = {};
      updateCartBadge();
      showToast('✅ تم استلام طلبك! سيصل خلال 25-35 دقيقة');
      setTimeout(() => window.location.href = '/orders', 2000);
    }

    async function filterCategory(cat) {
      await loadStores(cat === 'الكل' ? null : cat);
    }

    function showToast(msg, isError=false) {
      let t = document.getElementById('toast');
      if (!t) { t = document.createElement('div'); t.id='toast'; t.style.cssText='position:fixed;top:20px;left:50%;transform:translateX(-50%);padding:12px 24px;border-radius:12px;color:white;font-weight:700;z-index:9999;transition:opacity .3s;opacity:0'; document.body.appendChild(t); }
      t.textContent = msg;
      t.style.background = isError ? '#EF4444' : '#10B981';
      t.style.opacity = '1';
      setTimeout(() => t.style.opacity = '0', 3000);
    }
  </script>
</body>
</html>
